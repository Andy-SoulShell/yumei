# YUMEI 环境配置模板
# 复制为 .env 后填写；.env 已被 Git 忽略，禁止提交真实密钥。
# 下文“代码默认”指直接运行 Node；“Compose 默认/覆盖”指 docker compose。
# 注释掉表示不设置；KEY= 表示空字符串，两者不一定触发相同的默认逻辑。
# 示例密钥只用于展示格式；openssl 命令需在终端执行，.env 不执行命令。

# --- 运行环境与网络 ------------------------------------------------------------
# 枚举：development | test | production；代码默认 development。
# development：Vite 开发中间件；test：放宽数据库和加密主密钥的启动校验。
# production：静态资源、严格启动校验、启动时自动执行数据库迁移。
# pnpm dev/start 各自设置运行环境；Compose 固定 production，覆盖此值。
NODE_ENV=development

# 代码默认 3000。直接运行时为服务监听端口；Compose 中为宿主机映射端口，
# 容器内固定监听 3000。修改后也应同步 BETTER_AUTH_URL 中的公开端口。
PORT=3000

# 仅 Compose 使用；默认 0.0.0.0，向宿主机全部网卡发布端口。
# 127.0.0.1 仅允许本机访问。此项不控制直接 pnpm dev 时的监听地址。
# HOST_BIND=127.0.0.1

# --- 数据库 --------------------------------------------------------------------
# MySQL 8 连接地址；开发/生产必填，无代码默认连接，test 可不提供。
# 此示例适合宿主机已有 3306 端口数据库的情况。
# Compose 忽略本项，固定连接 db:3306/yumei，使用 yumei 用户和 MYSQL_PASSWORD。
# Compose 的 db 服务默认不向宿主机发布 3306 端口。
# 使用 docker-compose.dev.yml 时，先 up -d --wait db 等待就绪，再改用
# mysql://yumei:devpass@127.0.0.1:3307/yumei；密码需与 MYSQL_PASSWORD 一致。
DATABASE_URL=mysql://root:devpass@127.0.0.1:3306/yumei

# 仅 Compose 使用：应用数据库用户密码，Compose 默认 devpass。
# MYSQL_PASSWORD=replace-with-a-random-password
# 仅 Compose 使用：MySQL root 密码，Compose 默认 devpass-root。
# MYSQL_ROOT_PASSWORD=replace-with-a-different-random-password

# --- 登录与密钥加密 ------------------------------------------------------------
# 会话签名密钥：所有环境必填，至少 32 个字符，无默认值。
# 生成独立随机值：openssl rand -hex 32
JWT_SECRET=change-me-locally-then-rotate-in-production

# 用户自带 API 密钥（BYOK）的 AES-256-GCM 加密主密钥。
# 开发/生产必填，至少 32 个字符，必须与 JWT_SECRET 不同；无默认值。
# 再单独执行一次 openssl rand -hex 32，不能复用上面的结果。
# 更换后旧密文将无法解密，相关调用会要求重新保存 BYOK，不会静默回退运营方。
# 轮换时需配套重新加密或让用户重新填写 API 密钥。
KEY_ENCRYPTION_KEY=change-me-to-a-different-secret-than-jwt

# 公开访问地址，影响邮箱验证、密码重置、登录链接、可信来源和持久化的文件 URL。
# 代码默认 http://localhost:<PORT>，production 必填。
# Compose 默认 http://localhost:3000，不会随 PORT 自动改变。
# 本机 Docker 可设 http://localhost:3000；部署域名须填写实际地址。
# BETTER_AUTH_URL=https://yumei.example.com

# --- 认证邮件（邮箱验证、密码重置与邮箱链接登录共用） -----------------------------
# 可选值：resend | smtp | stdout；建议明确填写这些值之一。
# 未设置/留空：有 RESEND_API_KEY 时用 Resend，否则开发/测试输出日志；
# 生产缺少真实发信配置会阻止启动，显式 stdout 是本机调试的例外。
# stdout：完整认证链接写入服务日志，日志持有人可用该链接验证、重置密码或登录。
# resend：通过 Resend 发信，需要 RESEND_API_KEY。
# smtp：通过 SMTP 发信，需要 SMTP_HOST、SMTP_USER、SMTP_PASS。
# EMAIL_PROVIDER=stdout

# Resend 发信凭据，无默认值；未填写时不能使用 Resend。
# RESEND_API_KEY=re_...

# SMTP 主机，无默认值；仅 EMAIL_PROVIDER=smtp 时使用并要求非空。
# SMTP_HOST=smtp.example.com
# SMTP 端口，整数；代码仅在变量未设置时默认 587。
# 465 启用隐式 TLS；587 使用普通连接并按服务器支持升级 STARTTLS。
# Compose 会将未填写项传成空字符串，使用 SMTP 时请显式填写端口。
# SMTP_PORT=587
# SMTP 用户名和密码，无默认值；仅 smtp 模式必填。
# SMTP_USER=your-user
# SMTP_PASS=your-pass

# 发信身份；代码默认 noreply@yumei.local，生产真实发信时必填。
# Compose 默认 YUMEI <noreply@example.com>，真实发信须替换为服务允许的地址。
# EMAIL_FROM=YUMEI <noreply@example.com>

# --- 文件存储 ------------------------------------------------------------------
# 枚举：local | s3；代码和 Compose 默认 local，不支持其他值。
# local：保存到本地目录，由 /files/<key> 提供访问。
# s3：保存到 AWS S3 或兼容服务；需配置 S3_BUCKET、S3_REGION。
# 私有桶通过应用生成短期签名链接读取；文件 URL 本身不做用户身份校验。
STORAGE_DRIVER=local

# local 模式目录；代码默认 ./data/uploads，test 默认 /tmp/yumei-test-uploads。
# Compose 固定覆盖为 /app/data/uploads，并挂载 uploads 数据卷。
# STORAGE_LOCAL_DIR=./data/uploads

# s3 模式必填：桶名、区域；均无默认值。兼容服务也需要其接受的区域标识。
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# 可选静态凭据，使用时成对填写；不填时使用 AWS SDK 默认凭据链。
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# 可选兼容服务端点 URL；不填时使用 AWS 区域端点。
# S3_ENDPOINT=https://your-s3-compatible-endpoint.example.com

# --- 免费额度与订阅 ------------------------------------------------------------
# 枚举：free | none | lemonsqueezy；代码和 Compose 默认 free。
# free：免费用户每天 30 条聊天、1 张自拍，最多 1 个未删除角色；不开放付费入口。
#       每日额度按 UTC 00:00 重置（北京时间 08:00），角色数量不按日重置。
#       用户配置对应服务的 BYOK 时，该服务按现有规则豁免额度扣减。
#       聊天/自拍/合照先预留额度，生成或保存失败会退回原周期；过期预留每分钟补偿。
# none：自托管模式，按 Pro 开放能力并跳过业务用量计量；仍需登录和满足年龄等条件。
# lemonsqueezy：按订阅状态分层、计量，并接收 Lemon Squeezy Webhook。
#       月度额度按 UTC 每月 1 日重置；付费金额由外部收银台配置决定。
#       欠费宽限最多 7 天，已过 endsAt 则停止权益；付款事件不单独改变套餐。
BILLING_PROVIDER=free

# 仅 lemonsqueezy 模式必填，无默认值；与支付平台 Webhook 签名密钥一致。
# 接收路径：/api/billing/lemon-webhook。需订阅 subscription_created、subscription_updated；
# 完整订阅事件必须包含 updated_at，付款事件仅作收据，不能替代订阅状态通知。
# LEMONSQUEEZY_WEBHOOK_SECRET=
# 初始 Plus / Pro 托管收银台链接，无默认值；仅在新库首次初始化业务配置时导入。
# 初始化后通过 productConfig 管理 API 修改；缺少链接时不提供对应升级入口。
# 应用会自动附加 checkout[custom][user_id] 关联当前用户。
# LEMONSQUEEZY_CHECKOUT_PLUS=https://your-store.lemonsqueezy.com/buy/...
# LEMONSQUEEZY_CHECKOUT_PRO=https://your-store.lemonsqueezy.com/buy/...
# 初始产品变体 ID，纯数字，无默认值；同样仅在新库首次初始化时导入。
# 初始化后由管理 API 维护套餐 ID 与支付变体的精确映射；未映射的订阅事件会被拒绝。
# LEMONSQUEEZY_VARIANT_PLUS=
# LEMONSQUEEZY_VARIANT_PRO=

# --- Web Push 推送 -------------------------------------------------------------
# 生成配对公私钥：pnpm exec web-push generate-vapid-keys。
# 两项均无默认值；设备推送需同时配置，前端订阅开关依赖公钥是否存在。
# 主动联系调度与站内消息不依赖 VAPID，但账号须在联系偏好中显式开启。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# 推送服务联系标识，使用 mailto: 地址或 HTTPS URL。
# 未设置/留空时默认 mailto:admin@example.com，应替换为实际联系方式。
# VAPID_SUBJECT=mailto:you@example.com

# --- 图像生成 ------------------------------------------------------------------
# 枚举：fal | comfyui；代码和 Compose 默认 fal，不支持其他值。
# fal：调用托管图像接口，需 OPERATOR_FAL_KEY 或用户自己的 fal 密钥。
# comfyui：调用自建 ComfyUI；需 COMFYUI_BASE_URL。
# 用户已保存的 fal BYOK 优先于运营方选择，包括运营方配置为 comfyui 时。
IMAGE_PROVIDER=fal

# comfyui 模式必填，无默认值。必须从应用运行环境可达，不能只在浏览器可达。
# HTTP(S) 地址可含路径前缀，不允许用户名、密码、查询参数或片段。
# COMFYUI_BASE_URL=http://192.168.0.20:8188
# 可选反向代理 Bearer 凭据，无默认值；普通自建 ComfyUI 通常无需填写。
# COMFYUI_API_KEY=
# 超时，单位毫秒；默认 600000（10 分钟），整数范围 1000～1800000。
# 包含上传、排队和生成；本地超时并不保证远端任务立即停止。
COMFYUI_TIMEOUT_MS=600000
# 工作流目录，未设置/留空默认 workflows/comfyui。
# 内置 qwen-image-edit.json 和 qwen-image-text.json；仅直接运行时读取此配置。
# Compose 当前未透传本项；容器使用内置目录，若自定义需另行配置挂载和环境映射。
# COMFYUI_WORKFLOW_DIR=workflows/comfyui

# fal 合照模型 ID，未设置/留空默认 fal-ai/nano-banana/edit。
# 自定义模型需接受 prompt、image_urls；comfyui 模式不使用此项。
# FAL_COUPLE_MODEL=fal-ai/nano-banana/edit

# --- 聊天服务 ------------------------------------------------------------------
# 枚举：openrouter | deepseek；默认 openrouter，不支持其他值。
# openrouter：需 OPERATOR_OPENROUTER_KEY；deepseek：需 OPERATOR_DEEPSEEK_KEY。
# 同时影响聊天和记忆提取；用户已保存的 OpenRouter BYOK 会优先使用 OpenRouter。
LLM_PROVIDER=openrouter
# 可选：运营方 OpenAI 兼容网关 API 基址；留空使用上述服务官方地址。
# 仅发送运营方凭据，用户 OpenRouter BYOK 仍固定发送官方地址。末尾不带 /chat/completions。
OPERATOR_CHAT_BASE_URL=

# 陪伴任务与上下文预算。功能关闭不切换用户数据接收方。
COMPANION_MEMORY_ENABLED=1
COMPANION_PROACTIVE_ENABLED=1
# 空值使用所选服务的聊天模型；语义模型空值时只用词面召回。
MEMORY_EXTRACTION_MODEL=
MEMORY_EMBEDDING_MODEL=
AI_DAILY_TASK_LIMIT=200
AI_TASK_TIMEOUT_MS=30000
CHAT_CONTEXT_CHAR_LIMIT=80000
CHAT_MAX_OUTPUT_CHARS=16000
CHAT_REPLY_TIMEOUT_MS=120000
CHAT_STREAM_CONCURRENCY=4
CHAT_USER_CONCURRENCY=3
PROACTIVE_TICK_MS=60000
# 必须短于共享投递租约；超时/离线设备保留有限退避重试。
PROACTIVE_PUSH_TIMEOUT_MS=8000
# 仅 deepseek 模式使用的模型 ID，未设置/留空默认 deepseek-flash。
# 可填写 DeepSeek 接口支持的模型 ID；不适用于 OpenRouter 的模型选择。
DEEPSEEK_MODEL=deepseek-flash

# --- 运营方 AI 密钥 ------------------------------------------------------------
# 以下均为可选字符串，无默认值；未填且用户无对应 BYOK 时，相关服务无法调用。
# 用户在设置页保存的同类密钥会覆盖运营方密钥；不同服务之间不会自动互相替代。
# DeepSeek 官方聊天和记忆提取。
OPERATOR_DEEPSEEK_KEY=
# OpenRouter 聊天和记忆提取。
OPERATOR_OPENROUTER_KEY=
# fal 自拍和合照生成。
OPERATOR_FAL_KEY=
# ElevenLabs 高级语音合成，仍受当前套餐功能权限限制。
OPERATOR_ELEVENLABS_KEY=
# Fish Audio 高级语音合成，仍受当前套餐功能权限限制。
OPERATOR_FISH_AUDIO_KEY=
# OpenAI Whisper 语音转文字。
OPERATOR_OPENAI_KEY=

# --- 开发工具 ------------------------------------------------------------------
# 直接运行开发服务时，仅字符串 1 开启启动迁移；默认不迁移。
# production 始终自动迁移，填 0 也不会关闭；Compose 无需透传此项。
# MIGRATE_ON_BOOT=1

# 额外的本地访问域名，多个以逗号分隔，不含协议、端口或通配符；留空无需额外配置。
# 默认识别 localhost、127.0.0.1、本机主机名、.local 名称及本机局域网 IPv4 地址。
# 开发与显式 stdout 模式的认证共用此白名单；公网发信模式仍只信任 BETTER_AUTH_URL。
# pnpm dev/start 会读取 .env；直接执行 Vite CLI 时需自行传入进程变量。
# 自定义域名需要设备通过局域网 DNS 或 hosts 将其解析到本机。
# VITE_EXTRA_ALLOWED_HOST=yumei.home,yumei.lan
