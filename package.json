    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cookie": "^2.0.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "express": "^4.22.3",
    "i18next": "^26.5.2",
    "lucide-react": "^0.453.0",
    "mysql2": "^3.24.6",
    "nanoid": "^5.1.16",
    "nodemailer": "^10.1.7",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "resend": "^6.34.1",
    "sonner": "^2.0.8",
