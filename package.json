{
  "name": "yumei",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "tsc --noEmit && eslint . --max-warnings 0 && prettier --check .",
    "test": "node scripts/test.mjs",
    "test:db:up": "docker compose --env-file .env.test.local -f docker-compose.test.yml up -d --wait",
    "test:db:migrate": "node scripts/test.mjs --migrate",
    "test:i18n": "vitest run --config vitest.i18n.config.ts",
    "test:explore": "vitest run --config vitest.explore.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "ui:add": "pnpm dlx shadcn@4.22.1 add",
    "ui:migrate": "pnpm dlx shadcn@4.22.1 migrate radix",
    "test:db:reset": "node scripts/test.mjs --reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
